<service>
  <!-- WinSW v2.12.0 service definition for the bundled PostgreSQL.
       WinSW v2 convention: the XML must sit next to the service exe
       with the SAME base name (IterationBoardPG.exe /
       IterationBoardPG.xml) - install.bat copies both into app\.
       install.bat rewrites the absolute paths below (__INSTALL_DIR__)
       to the actual install path. -->
  <id>IterationBoardPG</id>
  <name>Iteration Board - PostgreSQL</name>
  <description>Iteration Board bundled PostgreSQL database (localhost only, port 15432).</description>
  <executable>__INSTALL_DIR__\runtime\pgsql\bin\postgres.exe</executable>
  <arguments>-D "__INSTALL_DIR__\data\pgdata" -p 15432</arguments>
  <workingdirectory>__INSTALL_DIR__</workingdirectory>
  <logpath>__INSTALL_DIR__\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <startmode>Automatic</startmode>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="10 sec"/>
</service>
