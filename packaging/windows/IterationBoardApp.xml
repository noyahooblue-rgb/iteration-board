<service>
  <!-- WinSW v2.12.0 service definition for the iteration-board
       application. WinSW v2 convention: the XML must sit next to the
       service exe with the SAME base name (IterationBoardApp.exe /
       IterationBoardApp.xml) - install.bat copies both into app\.
       Paths are relative to the service executable location (%BASE%,
       supported by v2); install.bat rewrites <workingdirectory> to
       the absolute install path. -->
  <id>IterationBoardApp</id>
  <name>Iteration Board - Application</name>
  <description>Iteration Board web application (Spring Boot).</description>
  <executable>%BASE%\..\runtime\jre\bin\java.exe</executable>
  <arguments>-jar "%BASE%\iteration-board.jar" --spring.config.additional-location=file:%BASE%\..\config\application.yml</arguments>
  <workingdirectory>__INSTALL_DIR__</workingdirectory>
  <logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <startmode>Automatic</startmode>
  <depend>IterationBoardPG</depend>
  <stoptimeout>30sec</stoptimeout>
  <onfailure action="restart" delay="10 sec"/>
</service>
